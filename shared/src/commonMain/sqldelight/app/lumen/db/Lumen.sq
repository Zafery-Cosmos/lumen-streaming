-- Base locale Lumen : profils du foyer et progression PAR PROFIL.
-- La bibliothèque est partagée (un seul compte Jellyfin) ; la reprise, non.

CREATE TABLE profile (
    id TEXT NOT NULL PRIMARY KEY,
    serverUrl TEXT NOT NULL DEFAULT '',   -- chaque serveur a SES profils
    name TEXT NOT NULL,
    colorIndex INTEGER NOT NULL DEFAULT 0,
    avatar TEXT,                -- nom de ressource (avatar_01…) ou NULL → initiale
    pinHash TEXT,               -- SHA-256 du PIN, NULL si non verrouillé
    child INTEGER NOT NULL DEFAULT 0,
    maxAge INTEGER NOT NULL DEFAULT 10
);

-- Dossiers HLS deja transcodes, importes et indexes : lus SANS re-encodage.
CREATE TABLE hls_entry (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    year INTEGER,
    masterPath TEXT NOT NULL,
    posterUrl TEXT,
    backdropUrl TEXT,
    overview TEXT,
    durationSeconds REAL NOT NULL,
    resolution TEXT,
    segmentFormat TEXT NOT NULL,
    importedAt INTEGER NOT NULL,
    targetId TEXT NOT NULL DEFAULT ''   -- vide = dossier local ; sinon serveur
);

-- Sources de stockage perso (S3/R2/B2…), importees via QR code ou saisie
-- manuelle. Jamais partagees automatiquement : Lumen n'est qu'un client.
CREATE TABLE storage_source (
    id TEXT NOT NULL PRIMARY KEY,
    label TEXT NOT NULL,        -- nom donne par l'utilisateur ("Mon NAS", "R2 perso"…)
    kind TEXT NOT NULL,         -- s3 | r2 | b2 (toutes compatibles API S3)
    endpoint TEXT NOT NULL,
    region TEXT,
    bucket TEXT NOT NULL,
    accessKey TEXT NOT NULL,
    secretKey TEXT NOT NULL,
    importedAt INTEGER NOT NULL,
    folders TEXT NOT NULL DEFAULT ''   -- prefixes a indexer, un par ligne ; vide = tout
);

-- Connexions WebDAV perso (Nextcloud, Synology, mod_dav…). Meme principe que
-- storage_source : Lumen n'est qu'un client, rien n'est partage.
CREATE TABLE webdav_source (
    id TEXT NOT NULL PRIMARY KEY,
    label TEXT NOT NULL,
    baseUrl TEXT NOT NULL,
    username TEXT NOT NULL,
    password TEXT NOT NULL,
    importedAt INTEGER NOT NULL
);

-- Titres indexes depuis un bucket perso : la carte de l accueil pointe soit
-- un objet video (lu par URL signee), soit un master.m3u8 (lu via le proxy
-- local qui signe chaque segment a la volee).
CREATE TABLE bucket_entry (
    id TEXT NOT NULL PRIMARY KEY,
    sourceId TEXT NOT NULL,      -- storage_source.id d'origine
    title TEXT NOT NULL,
    year INTEGER,
    kind TEXT NOT NULL,          -- file | hls
    objectKey TEXT NOT NULL,     -- cle de l objet ou du master.m3u8
    posterUrl TEXT,
    backdropUrl TEXT,
    overview TEXT,
    indexedAt INTEGER NOT NULL
);

-- Destination d envoi : le serveur qui heberge la mediatheque. Les dossiers
-- HLS y sont deposes, puis relus a distance — plus rien ne depend du PC.
CREATE TABLE upload_target (
    id TEXT NOT NULL PRIMARY KEY,
    label TEXT NOT NULL,
    kind TEXT NOT NULL,          -- sftp | ftp
    host TEXT NOT NULL,
    port INTEGER NOT NULL,
    username TEXT NOT NULL,
    password TEXT NOT NULL,
    remoteDir TEXT NOT NULL,
    importedAt INTEGER NOT NULL
);

-- Connexions FTP perso. Meme principe que storage_source/webdav_source.
CREATE TABLE ftp_source (
    id TEXT NOT NULL PRIMARY KEY,
    label TEXT NOT NULL,
    host TEXT NOT NULL,
    port INTEGER NOT NULL,
    username TEXT NOT NULL,
    password TEXT NOT NULL,
    importedAt INTEGER NOT NULL
);

CREATE TABLE watch_state (
    profileId TEXT NOT NULL,
    itemId TEXT NOT NULL,
    positionMs INTEGER NOT NULL,
    durationMs INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    PRIMARY KEY (profileId, itemId)
);

selectProfiles:
SELECT * FROM profile WHERE serverUrl = ?;

-- Reprise des profils crees avant la separation par serveur.
adoptOrphanProfiles:
UPDATE profile SET serverUrl = ? WHERE serverUrl = '';

insertProfile:
INSERT INTO profile(id, serverUrl, name, colorIndex, avatar, pinHash, child, maxAge)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateProfile:
UPDATE profile SET name = ?, colorIndex = ?, avatar = ?, pinHash = ?, child = ?, maxAge = ?
WHERE id = ?;

deleteProfile:
DELETE FROM profile WHERE id = ?;

upsertWatchState:
INSERT OR REPLACE INTO watch_state(profileId, itemId, positionMs, durationMs, updatedAt)
VALUES (?, ?, ?, ?, ?);

resumeForProfile:
SELECT * FROM watch_state
WHERE profileId = ?
  AND positionMs > 60000
  AND (positionMs * 100.0) / durationMs < 92
ORDER BY updatedAt DESC
LIMIT 12;

positionFor:
SELECT positionMs FROM watch_state WHERE profileId = ? AND itemId = ?;

deleteWatchStateForProfile:
DELETE FROM watch_state WHERE profileId = ?;

selectHlsEntries:
SELECT * FROM hls_entry ORDER BY importedAt DESC;

insertHlsEntry:
INSERT OR REPLACE INTO hls_entry(
    id, title, year, masterPath, posterUrl, backdropUrl, overview,
    durationSeconds, resolution, segmentFormat, importedAt, targetId
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteHlsEntry:
DELETE FROM hls_entry WHERE id = ?;

selectStorageSources:
SELECT * FROM storage_source ORDER BY importedAt DESC;

insertStorageSource:
INSERT OR REPLACE INTO storage_source(
    id, label, kind, endpoint, region, bucket, accessKey, secretKey, importedAt, folders
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteStorageSource:
DELETE FROM storage_source WHERE id = ?;

selectWebDavSources:
SELECT * FROM webdav_source ORDER BY importedAt DESC;

insertWebDavSource:
INSERT OR REPLACE INTO webdav_source(id, label, baseUrl, username, password, importedAt)
VALUES (?, ?, ?, ?, ?, ?);

deleteWebDavSource:
DELETE FROM webdav_source WHERE id = ?;

selectBucketEntries:
SELECT * FROM bucket_entry ORDER BY title;

insertBucketEntry:
INSERT OR REPLACE INTO bucket_entry(
    id, sourceId, title, year, kind, objectKey, posterUrl, backdropUrl, overview, indexedAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteBucketEntry:
DELETE FROM bucket_entry WHERE id = ?;

deleteBucketEntriesForSource:
DELETE FROM bucket_entry WHERE sourceId = ?;

selectUploadTargets:
SELECT * FROM upload_target ORDER BY importedAt DESC;

insertUploadTarget:
INSERT OR REPLACE INTO upload_target(
    id, label, kind, host, port, username, password, remoteDir, importedAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteUploadTarget:
DELETE FROM upload_target WHERE id = ?;

selectFtpSources:
SELECT * FROM ftp_source ORDER BY importedAt DESC;

insertFtpSource:
INSERT OR REPLACE INTO ftp_source(id, label, host, port, username, password, importedAt)
VALUES (?, ?, ?, ?, ?, ?, ?);

deleteFtpSource:
DELETE FROM ftp_source WHERE id = ?;
