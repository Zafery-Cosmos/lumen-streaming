-- Base locale Lumen : profils du foyer et progression PAR PROFIL.
-- La bibliothèque est partagée (un seul compte Jellyfin) ; la reprise, non.

CREATE TABLE profile (
    id TEXT NOT NULL PRIMARY KEY,
    serverUrl TEXT NOT NULL DEFAULT '',   -- chaque serveur a SES profils
    name TEXT NOT NULL,
    colorIndex INTEGER NOT NULL DEFAULT 0,
    avatar TEXT,                -- nom de ressource (avatar_01…) ou NULL → initiale
    pinHash TEXT,               -- SHA-256 du PIN, NULL si non verrouillé
    child INTEGER NOT NULL DEFAULT 0,
    maxAge INTEGER NOT NULL DEFAULT 10
);

-- Dossiers HLS deja transcodes, importes et indexes : lus SANS re-encodage.
CREATE TABLE hls_entry (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    year INTEGER,
    masterPath TEXT NOT NULL,
    posterUrl TEXT,
    backdropUrl TEXT,
    overview TEXT,
    durationSeconds REAL NOT NULL,
    resolution TEXT,
    segmentFormat TEXT NOT NULL,
    importedAt INTEGER NOT NULL
);

CREATE TABLE watch_state (
    profileId TEXT NOT NULL,
    itemId TEXT NOT NULL,
    positionMs INTEGER NOT NULL,
    durationMs INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    PRIMARY KEY (profileId, itemId)
);

selectProfiles:
SELECT * FROM profile WHERE serverUrl = ?;

-- Reprise des profils crees avant la separation par serveur.
adoptOrphanProfiles:
UPDATE profile SET serverUrl = ? WHERE serverUrl = '';

insertProfile:
INSERT INTO profile(id, serverUrl, name, colorIndex, avatar, pinHash, child, maxAge)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateProfile:
UPDATE profile SET name = ?, colorIndex = ?, avatar = ?, pinHash = ?, child = ?, maxAge = ?
WHERE id = ?;

deleteProfile:
DELETE FROM profile WHERE id = ?;

upsertWatchState:
INSERT OR REPLACE INTO watch_state(profileId, itemId, positionMs, durationMs, updatedAt)
VALUES (?, ?, ?, ?, ?);

resumeForProfile:
SELECT * FROM watch_state
WHERE profileId = ?
  AND positionMs > 60000
  AND (positionMs * 100.0) / durationMs < 92
ORDER BY updatedAt DESC
LIMIT 12;

positionFor:
SELECT positionMs FROM watch_state WHERE profileId = ? AND itemId = ?;

deleteWatchStateForProfile:
DELETE FROM watch_state WHERE profileId = ?;

selectHlsEntries:
SELECT * FROM hls_entry ORDER BY importedAt DESC;

insertHlsEntry:
INSERT OR REPLACE INTO hls_entry(
    id, title, year, masterPath, posterUrl, backdropUrl, overview,
    durationSeconds, resolution, segmentFormat, importedAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteHlsEntry:
DELETE FROM hls_entry WHERE id = ?;
